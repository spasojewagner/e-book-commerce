PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/ebook-commerce
# Public address of this API; used for the download links in the email
API_URL=http://localhost:4000
# The store's address (CORS)
CLIENT_URL=http://localhost:5173

# Stripe test key from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...

# SMTP for sending the books (SendGrid by default; Mailtrap works for testing)
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USER=apikey
EMAIL_PASS=
EMAIL_FROM=
